<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Microphone capture. Must ALSO be set as entitlementsInherit — the
         Electron helper process is what actually opens the mic; without the
         inherited entitlement it silently fails under hardened runtime. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- JIT + unsigned memory for V8. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- sherpa-onnx / onnxruntime load unsigned dylibs. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
